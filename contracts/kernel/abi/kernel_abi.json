        "name": "load_base_chunk",
        "doc": " Owner only. Raw input (no JSON): `<chunk_idx> [raw|lz4|zlib]\\n<payload>`. The decoded\n payload must be whole NDJSON lines; chunk 0 starts with the meta line. Returns decoded base bytes so far.",
        "kind": "call",
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        }
      },
