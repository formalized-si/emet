-pub(crate) fn parse_export_file<'p, R: BufRead>(
+// Own optimisation: exact canonical app lines (the dominant export record).
+// All other encodings use the unchanged serde parser. Numeric overflow, extra
+// fields, duplicates, whitespace, escapes, and reordered keys miss this path.
+fn canonical_app(line: &str) -> Option<ExportJsonObject<'_>> {
+    struct Cursor<'a> { bytes: &'a [u8], i: usize }
+    impl Cursor<'_> {
+        fn eat(&mut self, s: &[u8]) -> Option<()> {
+            if self.bytes.get(self.i..self.i + s.len())? != s { return None; }
+            self.i += s.len(); Some(())
+        }
+        fn number(&mut self) -> Option<u32> {
+            let start = self.i;
+            let mut n = 0u32;
+            while let Some(b @ b'0'..=b'9') = self.bytes.get(self.i) {
+                n = n.checked_mul(10)?.checked_add((b - b'0') as u32)?;
+                self.i += 1;
+            }
+            if self.i == start || (self.i > start + 1 && self.bytes[start] == b'0') { return None; }
+            Some(n)
+        }
+    }
+    let mut c = Cursor { bytes: line.as_bytes(), i: 0 };
+    c.eat(b"{\"app\":{\"arg\":")?;
+    let arg = c.number()?;
+    c.eat(b",\"fn\":")?;
+    let fun = c.number()?;
+    c.eat(b"},\"ie\":")?;
+    let i = c.number()?;
+    c.eat(b"}")?;
+    if c.bytes.get(c.i..) != Some(b"" as &[u8]) && c.bytes.get(c.i..) != Some(b"\n" as &[u8]) { return None; }
+    Some(ExportJsonObject { val: ExportJsonVal::ExprApp { fun, arg }, i: Some(BackRef::Ie(i)) })
+}
