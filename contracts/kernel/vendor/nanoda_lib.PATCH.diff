+// --- spike: helpers for embedding (on-chain) use ---
+impl<'p> ExportFile<'p> {
+    /// Look up a declaration by its dot-separated name, e.g. "Nat.add_comm".
+    pub fn find_declar_by_str(&self, dot_separated_name: &str) -> Option<&crate::env::Declar<'p>> {
+        let n = self.dag.find_name(dot_separated_name)?;
+        self.declars.get(&n)
+    }
+
+    /// Check every declaration serially on the current thread (no thread spawn; wasm-safe).
+    pub fn check_all_declars_current_thread(&self) {
+        for declar in self.declars.values() {
+            self.check_declar(declar);
+        }
+    }
+
+    /// Pretty print one declaration (by name) to a String.
+    pub fn pp_declar_to_string(&self, dot_separated_name: &str) -> Option<String> {
+        self.with_ctx(|ctx| {
+            let n = ctx.name_from_str(dot_separated_name);
+            ctx.with_pp(|pp| pp.pp_declar(n))
+        })
+    }
+}
