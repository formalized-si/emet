+// --- kernel-prod: delta analysis helpers (pinned base + delta) ---
+/// What `ExportFile::analyze` learned about a base+delta environment.
+pub struct DeltaReport {
+    /// (kind, dotted name) of every declaration past the base.
+    pub new_decls: Vec<(&'static str, String)>,
+    /// insertion index of the target, if found.
+    pub target_index: Option<usize>,
+    /// kind of the target, if found.
+    pub target_kind: Option<&'static str>,
+    /// constants mentioned by the target's statement that are not base declarations.
+    pub stmt_nonbase_consts: Vec<String>,
+    /// nanoda debug print of the target's type (input to the statement hash).
+    pub stmt_debug: String,
+    /// axioms the target transitively depends on (through types and values).
+    pub axioms_used: Vec<String>,
+    /// constants the target transitively mentions that are not in the environment.
+    pub missing_consts: Vec<String>,
+}
+
+impl<'p> ExportFile<'p> {
+    /// Short kind label of a declaration.
+    pub fn declar_kind(d: &crate::env::Declar<'p>) -> &'static str {
+        use crate::env::Declar::*;
+        match d {
+            Axiom { .. } => "axiom",
+            Quot { .. } => "quot",
+            Theorem { .. } => "theorem",
+            Definition { .. } => "def",
+            Opaque { .. } => "opaque",
+            Inductive(..) => "inductive",
+            Constructor(..) => "ctor",
+            Recursor(..) => "rec",
+        }
+    }
+
+    /// Analyse the declarations at insertion index >= `base_decls` and the target theorem.
+    pub fn analyze(&self, base_decls: usize, target: &str, want_axioms: bool) -> DeltaReport {
+        use crate::env::Declar::*;
+        use crate::expr::Expr;
+        self.with_ctx(|ctx| {
+            fn nstr<'t, 'q: 't>(ctx: &TcCtx<'t, 'q>, n: NamePtr<'t>) -> String {
+                match ctx.read_name(n) {
+                    crate::name::Name::Anon => String::new(),
+                    crate::name::Name::Str(p, s, _) => {
+                        let pre = nstr(ctx, p);
+                        let s = ctx.read_string(s).to_string();
+                        if pre.is_empty() { s } else { format!("{pre}.{s}") }
+                    }
+                    crate::name::Name::Num(p, k, _) => format!("{}.{}", nstr(ctx, p), k),
+                }
+            }
+            let mut new_decls = Vec::new();
+            for i in base_decls..self.declars.len() {
+                let (n, d) = self.declars.get_index(i).unwrap();
+                new_decls.push((Self::declar_kind(d), nstr(ctx, *n)));
+            }
+            let target_name = self.dag.find_name(target);
+            let target_index = target_name.and_then(|n| self.declars.get_index_of(&n));
+            let target_decl = target_name.and_then(|n| self.declars.get(&n));
+            let target_kind = target_decl.map(Self::declar_kind);
+            let mut stmt_nonbase_consts = Vec::new();
+            let mut stmt_debug = String::new();
+            let mut axioms_used = Vec::new();
+            let mut missing_consts = Vec::new();
+            if let Some(d) = target_decl {
+                let ty = d.info().ty;
+                stmt_debug = format!("{:?}", ctx.debug_print(ty));
+                // constants in the statement
+                let mut stack = vec![ty];
+                let mut seen: FxHashSet<ExprPtr> = FxHashSet::default();
+                while let Some(e) = stack.pop() {
+                    if !seen.insert(e) { continue }
+                    match ctx.read_expr(e) {
+                        Expr::Const { name, .. } => {
+                            let idx = self.declars.get_index_of(&name);
+                            if idx.map(|i| i >= base_decls).unwrap_or(true) {
+                                let s = nstr(ctx, name);
+                                if !stmt_nonbase_consts.contains(&s) { stmt_nonbase_consts.push(s) }
+                            }
+                        }
+                        Expr::App { fun, arg, .. } => { stack.push(fun); stack.push(arg) }
+                        Expr::Pi { binder_type, body, .. } | Expr::Lambda { binder_type, body, .. } => { stack.push(binder_type); stack.push(body) }
+                        Expr::Let { binder_type, val, body, .. } => { stack.push(binder_type); stack.push(val); stack.push(body) }
+                        Expr::Proj { structure, .. } => stack.push(structure),
+                        _ => {}
+                    }
+                }
+                if want_axioms {
+                    // transitive constant closure from the target
+                    let mut names: Vec<NamePtr> = vec![target_name.unwrap()];
+                    let mut seen_names: FxHashSet<NamePtr> = FxHashSet::default();
+                    let mut seen_e: FxHashSet<ExprPtr> = FxHashSet::default();
+                    while let Some(n) = names.pop() {
+                        if !seen_names.insert(n) { continue }
+                        let mut roots: Vec<ExprPtr> = Vec::new();
+                        match self.declars.get(&n) {
+                            None => { missing_consts.push(nstr(ctx, n)); continue }
+                            Some(Axiom { info }) => { axioms_used.push(nstr(ctx, n)); roots.push(info.ty) }
+                            Some(Quot { info }) => roots.push(info.ty),
+                            Some(Theorem { info, val }) | Some(Definition { info, val, .. }) | Some(Opaque { info, val }) => { roots.push(info.ty); roots.push(*val) }
+                            Some(Inductive(data)) => roots.push(data.info.ty),
+                            Some(Constructor(c)) => { roots.push(c.info.ty); names.push(c.inductive_name) }
+                            Some(Recursor(r)) => { roots.push(r.info.ty); for rr in r.rec_rules.iter() { roots.push(rr.val) } }
+                        }
+                        while let Some(e) = roots.pop() {
+                            if !seen_e.insert(e) { continue }
+                            match ctx.read_expr(e) {
+                                Expr::Const { name, .. } => names.push(name),
+                                Expr::App { fun, arg, .. } => { roots.push(fun); roots.push(arg) }
+                                Expr::Pi { binder_type, body, .. } | Expr::Lambda { binder_type, body, .. } => { roots.push(binder_type); roots.push(body) }
+                                Expr::Let { binder_type, val, body, .. } => { roots.push(binder_type); roots.push(val); roots.push(body) }
+                                Expr::Proj { ty_name, structure, .. } => { names.push(ty_name); roots.push(structure) }
+                                _ => {}
+                            }
+                        }
+                    }
+                    axioms_used.sort();
+                }
+            }
+            DeltaReport { new_decls, target_index, target_kind, stmt_nonbase_consts, stmt_debug, axioms_used, missing_consts }
+        })
+    }
+}
+
+// --- kernel-prod: claim mode ---
+impl<'p> ExportFile<'p> {
+    /// If `claim` is a base definition of type `Prop` (sort 0), return the name of a delta
+    /// theorem (insertion index >= `base_decls`) whose type is exactly the constant `claim`.
+    /// `Ok(None)`: `claim` is not a base Prop definition (caller falls back to theorem mode).
+    /// `Err(..)`: `claim` is a base Prop definition but no delta theorem has that exact type.
+    pub fn claim_proof(&self, base_decls: usize, claim: &str) -> Result<Option<String>, String> {
+        use crate::env::Declar;
+        use crate::expr::Expr;
+        let Some(cn) = self.dag.find_name(claim) else { return Ok(None) };
+        let Some(ci) = self.declars.get_index_of(&cn) else { return Ok(None) };
+        if ci >= base_decls { return Ok(None) }
+        let Some(Declar::Definition { info, .. }) = self.declars.get(&cn) else { return Ok(None) };
+        self.with_ctx(|ctx| {
+            let is_prop = match ctx.read_expr(info.ty) {
+                Expr::Sort { level, .. } => matches!(ctx.read_level(level), crate::level::Level::Zero),
+                _ => false,
+            };
+            if !is_prop { return Ok(None) }
+            for i in base_decls..self.declars.len() {
+                let (n, d) = self.declars.get_index(i).unwrap();
+                if let Declar::Theorem { info, .. } = d {
+                    if let Expr::Const { name, levels, .. } = ctx.read_expr(info.ty) {
+                        if name == cn && ctx.read_levels(levels).is_empty() {
+                            return Ok(Some(format!("{:?}", ctx.debug_print(*n)).trim_matches('`').to_string()));
+                        }
+                    }
+                }
+            }
+            Err(format!("no theorem in the delta has type exactly `{claim}`"))
+        })
+    }
+}
+
+// Own read-only embedding accessor. Ptr index is exactly the back-reference
+// validated by parser BackRef::assert_in; no typechecking behavior changes.
+impl<'p> ExportFile<'p> {
+    pub fn declaration_name_indices(&self) -> Vec<u64> {
+        self.declars.keys().map(|n| n.idx() as u64).collect()
+    }
+}
